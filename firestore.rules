rules_version = '2';

// TimelineGoal security rules — SKELETON (M0). Enforces the core invariant:
// a couple's world is theirs alone (membership-only access under couples/{coupleId}).
// Field-level validation and hardened pairing land in M1 alongside auth + rules tests.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True if the signed-in user is one of the (≤2) members of this couple.
    function isMember(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // A user's own profile — only the owner.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Pairing invite codes. Creator mints one; a joiner looks it up then deletes it.
    // (The join itself is authorized on the couple doc below.)
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if signedIn();
      allow list, update: if false;
    }

    match /couples/{coupleId} {
      allow get: if isMember(coupleId);
      allow list: if false;
      allow delete: if false;

      // Create: the creator must be one of the initial members (couple starts with 1–2).
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 2;

      // Update: either an existing member editing the couple,
      // OR a signed-in second person joining a 1-member couple (1 → 2, keeping the original).
      allow update: if (isMember(coupleId) && request.resource.data.members.size() <= 2)
        || (
          signedIn()
          && resource.data.members.size() == 1
          && request.resource.data.members.size() == 2
          && request.auth.uid in request.resource.data.members
          && resource.data.members[0] in request.resource.data.members
        );

      // Everything under a couple (goals, checkins, corners, pins, messages, reactions…)
      // is gated by membership of that couple.
      match /{document=**} {
        allow read, write: if isMember(coupleId);
      }
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
